   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. every number/ID comes from real data\n2. re-runs each claim and compares\n3. says which corrections were used + by whom\n4. shows it when sources disagree\n5. the chart type fits the data\n6. states its assumptions (date range...)",
   "originalText": "1. every number/ID comes from real data\n2. re-runs each claim and compares\n3. says which corrections were used + by whom\n4. shows it when sources disagree\n5. the chart type fits the data\n6. states its assumptions (date range...)",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
