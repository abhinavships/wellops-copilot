  },
  {
   "id": "7kywhjpmc9cuhy39",
   "type": "text",
   "x": 56,
   "y": 331.0,
   "width": 448.00000000000006,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1315179733,
   "version": 1,
   "versionNonce": 1804194916,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The model is swappable. The harness makes it safe:\n  playbooks + tools + memory + checks + retries\n\nScore = model + harness + data + budget\nSame harness, different model:\n  tiny 2B local model -> refused (no fake answers)\n  Nemotron 120B -> passed all 6 checks, ~30 s",
   "originalText": "The model is swappable. The harness makes it safe:\n  playbooks + tools + memory + checks + retries\n\nScore = model + harness + data + budget\nSame harness, different model:\n  tiny 2B local model -> refused (no fake answers)\n  Nemotron 120B -> passed all 6 checks, ~30 s",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
