# Model provider (any OpenAI-compatible endpoint works)
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MODEL_ORCHESTRATOR=openrouter:nvidia/nemotron-3-super-120b-a12b:free
MODEL_WORKER=openrouter:poolside/laguna-s-2.1:free
# Opik (Comet cloud)
OPIK_API_KEY=
OPIK_WORKSPACE=
OTEL_EXPORTER_OTLP_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
# Runtime
DATA_DIR=../dataset/sample-data
DATASET_ID=sample
ACTIVE_DATASET=sample
CLOCK_TODAY=2026-10-17
DB_PATH=wellops.duckdb
# Local GPU box (RTX 5090, LAN) — unlimited, no key. Ollama OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://192.168.10.222:11434/v1
MODEL_LOCAL=ollama:gemma4-e2b-32k
# Fallback order tried on 429/5xx/timeouts
MODEL_FALLBACKS=ollama:gemma4-e2b-32k,openrouter:nvidia/nemotron-3-super-120b-a12b:free,openrouter:poolside/laguna-s-2.1:free
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=
